{
  "name": "sight-reading-trainer",
  "version": "0.1.0",
  "description": "Piano sight-reading trainer with MIDI input, VexFlow notation, and Tone.js audio",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit",
    "package": "electron-vite build && electron-builder"
  },
  "dependencies": {
    "tone": "^14.7.77",
    "vexflow": "^4.2.5"
  },
  "devDependencies": {
    "@electron-toolkit/utils": "^3.0.0",
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3",
    "electron-vite": "^2.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.4.5",
    "vite": "^5.3.0"
  },
  "build": {
    "appId": "com.sightreading.trainer",
    "productName": "Sight Reading Trainer",
    "mac": {
      "target": "dmg",
      "category": "public.app-category.music"
    },
    "files": ["out/**/*"],
    "directories": {
      "buildResources": "resources",
      "output": "dist"
    }
  }
}
